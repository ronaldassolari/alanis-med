generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH (next-auth v5) ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String?
  image         String?
  role          String    @default("ALUNO") // ALUNO | PROFESSOR | ADMIN
  especialidade String?
  pontos        Int       @default(0)
  streakDias    Int       @default(0)
  ultimoEstudo  DateTime?
  planoAtivo    String    @default("basico")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions   Session[]
  accounts   Account[]
  badges     UserBadge[]
  metas      Meta[]
  testes     Teste[]
  notas      Nota[]
  progresso  Progresso[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── GAMIFICAÇÃO ─────────────────────────────────────────────────────────────

model Badge {
  id       String @id @default(cuid())
  nome     String
  descricao String
  icone    String
  cor      String @default("#0066FF")
  criterio String
  pontos   Int    @default(50)

  usuarios UserBadge[]

  @@map("badges")
}

model UserBadge {
  id      String   @id @default(cuid())
  userId  String
  badgeId String
  ganhoEm DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Meta {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  descricao String
  meta      Int
  atual     Int      @default(0)
  concluida Boolean  @default(false)
  data      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("metas")
}

// ─── AULAS ──────────────────────────────────────────────────────────────────

model Aula {
  id         String   @id @default(cuid())
  titulo     String
  descricao  String
  videoUrl   String?
  conteudo   String?
  disciplina String
  tema       String?
  tipo       String   @default("video")
  nivel      String   @default("basico")
  duracao    Int?
  ordem      Int      @default(0)
  mes        Int?
  semana     Int?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  progresso Progresso[]

  @@map("aulas")
}

model Progresso {
  id         String    @id @default(cuid())
  userId     String
  aulaId     String
  percentual Int       @default(0)
  concluido  Boolean   @default(false)
  dataInicio DateTime  @default(now())
  dataFim    DateTime?
  tempoGasto Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  aula Aula @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([userId, aulaId])
  @@map("progresso")
}

// ─── QUESTÕES E PROVAS ───────────────────────────────────────────────────────

model Prova {
  id            String   @id @default(cuid())
  nome          String
  tipo          String
  subtipo       String   @default("completa")
  ano           Int?
  disciplina    String?
  tema          String?
  descricao     String?
  tempoPrevisto Int?
  dificuldade   String   @default("medio")
  geradaPorIA   Boolean  @default(false)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  questoes Questao[]
  testes   Teste[]

  @@map("provas")
}

model Questao {
  id          String  @id @default(cuid())
  provaId     String
  enunciado   String
  opcaoA      String
  opcaoB      String
  opcaoC      String
  opcaoD      String
  opcaoE      String?
  gabarito    String
  explicacao  String?
  referencia  String?
  disciplina  String?
  tema        String?
  dificuldade String  @default("medio")
  ordem       Int     @default(0)
  geradaPorIA Boolean @default(false)

  prova Prova @relation(fields: [provaId], references: [id], onDelete: Cascade)

  @@map("questoes")
}

model Teste {
  id         String   @id @default(cuid())
  userId     String
  provaId    String?
  tipo       String   @default("tematico")
  respostas  String   @default("{}")
  acertos    Int      @default(0)
  total      Int      @default(0)
  tempo      Int?
  pontos     Int      @default(0)
  completado Boolean  @default(false)
  analise    String?
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prova Prova? @relation(fields: [provaId], references: [id], onDelete: SetNull)
  nota  Nota?

  @@map("testes")
}

model Nota {
  id        String   @id @default(cuid())
  userId    String
  testeId   String   @unique
  valor     Float
  aprovado  Boolean
  percentil Int?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  teste Teste @relation(fields: [testeId], references: [id], onDelete: Cascade)

  @@map("notas")
}
